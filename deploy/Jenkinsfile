pipeline {
  agent any

  // 👇 Parameterized inputs
  parameters {
    string(
      name: 'inventory',
      defaultValue: 'dev',
      description: 'Environment inventory to deploy configuration (e.g. dev, sit, pentest)'
    )
    string(
      name: 'ansible_tags',
      defaultValue: '',
      description: 'Optional Ansible tag(s) to limit execution (e.g. webserver, db). Leave empty to run all.'
    )
  }

  environment {
    ANSIBLE_CONFIG = "${WORKSPACE}/deploy/.ansible.cfg"
  }

  stages {
    stage('Clean Workspace') {
      steps {
        cleanWs()
      }
    }

    stage('Checkout SCM') {
      steps {
        echo "Checking out main branch..."
        git branch: 'main', url: 'https://github.com/princemaxi/ansible-config-mgt.git'
      }
    }

    stage('Validate Workspace') {
      steps {
        echo "Listing files to confirm structure..."
        sh 'pwd && ls -R'
      }
    }

    stage('Run Ansible Playbook') {
      steps {
        script {
          echo "Starting Ansible Deployment..."
          sh '''
            echo "Using ansible config at: $ANSIBLE_CONFIG"
            echo "Deploying environment: ${inventory}"
            if [ -z "${ansible_tags}" ]; then
              echo "Running full playbook for ${inventory}..."
              ansible-playbook -i inventory/${inventory}.ini playbooks/site.yml
            else
              echo "Running playbook for ${inventory} with tags: ${ansible_tags}"
              ansible-playbook -i inventory/${inventory}.ini playbooks/site.yml --tags "${ansible_tags}"
            fi
          '''
        }
      }
    }

    stage('SonarQube Quality Gate') {
    when { branch pattern: "^develop*|^hotfix*|^release*|^main*", comparator: "REGEXP" }
    environment {
        scannerHome = tool 'SonarQubeScanner'
    }
    steps {
        withSonarQubeEnv('SonarQubeServer') {
            sh "${scannerHome}/bin/sonar-scanner -Dproject.settings=sonar-project.properties"
        }
        timeout(time: 1, unit: 'MINUTES') {
            waitForQualityGate abortPipeline: true
        }
    }


  }

  post {
    always {
      echo "Pipeline completed!"
    }
  }
}
}

